# Backend only. Never put this key in the Android app or in Git.
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_MODEL=muse-spark-1.3

# Maximum authorized project spend. The gateway enforces the lower configured limit.
GUIDINGHAND_PROJECT_BUDGET_USD=150

# Session allowance within the project ceiling; choose the amount you authorize.
GUIDINGHAND_SESSION_BUDGET_USD=5

# Create a random value with at least 32 characters. This authenticates the app
# to your backend; it is not a Meta key.
GUIDINGHAND_APP_SESSION_TOKEN=

# Persist this directory across deployments so budget reservations survive.
GUIDINGHAND_STATE_DIR=/var/lib/guidinghand
